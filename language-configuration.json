{
  "comments": {
    "lineComment": "%",
    "blockComment": ["%{", "%}"]
  },
  "brackets": [
    ["{", "}"],
    ["<<", ">>"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^(\\\\.|[^\\\\%])*(\\{(\\\\.|[^\\\\%}])*|<<(\\\\.|(?!>>)[^\\\\%])*)(%.*)?$",
    "decreaseIndentPattern": "^\\s*(\\}|>>|#\\})"
  },
  "autoClosingPairs": [
    { "open": "#{", "close": "#}" },
    { "open": "{", "close": "}" },
    { "open": "<<", "close": ">>" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["<<", ">>"],
    ["\"", "\""]
  ]
}
